# =====================================================================
# WhatsPulse CRM — Environment Configuration Template
# Copy this file to .env.local and configure your credentials
# =====================================================================

# ---------------------------------------------------------------------
# Application Environment & Base URLs
# ---------------------------------------------------------------------
# The canonical public HTTPS URL of your deployment (used for webhooks and asset URLs)
# For local dev with tunneling: https://your-subdomain.ngrok-free.app
# For production: https://crm.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Meta WhatsApp Cloud API (v20+) Credentials
# Retrieved from developers.facebook.com > WhatsApp > API Setup & App Settings > Basic
# See docs/META_SETUP.md for complete step-by-step instructions
# ---------------------------------------------------------------------
# Your Meta Phone Number ID (from WhatsApp > API Setup)
META_PHONE_NUMBER_ID=your_phone_number_id_here

# Your WhatsApp Business Account (WABA) ID (from WhatsApp > API Setup)
META_WABA_ID=your_waba_id_here

# Permanent System User Access Token (from Meta Business Settings > System Users)
# MUST have permissions: whatsapp_business_messaging, whatsapp_business_management
# Do NOT use temporary 24-hour test tokens for production
META_ACCESS_TOKEN=your_permanent_system_user_access_token_here

# Meta App Secret (from App Dashboard > App Settings > Basic)
# Used for HMAC-SHA256 signature verification on inbound webhooks
META_APP_SECRET=your_meta_app_secret_here

# Secret verification token string matching your webhook configuration in Meta
# Can be any random high-entropy alphanumeric string
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# ---------------------------------------------------------------------
# Cryptographic Security & Token Encryption at Rest
# ---------------------------------------------------------------------
# 32-byte cryptographic key (64 hex characters) used to encrypt Meta tokens with AES-256-GCM
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------
# Supabase PostgreSQL Database & Realtime Configuration
# Retrieved from your Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------
# Supabase Project HTTPS API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous Key (safe for client-side queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here

# Supabase Service Role Secret Key (REQUIRED for server-side webhook ingestion and background jobs)
# NEVER expose this key to the browser or public repositories
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key_here

# Direct PostgreSQL Connection String (used by setup wizard and CLI migration tooling)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your_password_here@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# Background Task & Cron Worker Security
# ---------------------------------------------------------------------
# Bearer secret required to trigger the background campaign worker route (/api/cron/outbound-worker)
# Matches the Authorization: Bearer <CRON_SECRET> header configured in Vercel Cron or your external scheduler
CRON_SECRET=your_high_entropy_cron_secret_string_here

# ---------------------------------------------------------------------
# AI Copilot Engine (Optional)
# If omitted, WhatsPulse uses smart deterministic heuristic suggestions
# ---------------------------------------------------------------------
# Google Gemini API Key (recommended, free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------
# Multi-Tenant Workspace Defaults (Optional)
# ---------------------------------------------------------------------
DEFAULT_WORKSPACE_ID=ws_prod_01
DEFAULT_WORKSPACE_PATH_TOKEN=default
